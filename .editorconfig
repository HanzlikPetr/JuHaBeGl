root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ zdrojáky
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

# Qt specifické soubory (projekty, UI design, zdroje)
[*.{pro,pri,ui,qrc}]
indent_style = space
indent_size = 4

# Makefile (Zde MUSÍ být tabulátory!)
[Makefile*]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
