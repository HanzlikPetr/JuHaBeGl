Language: Cpp
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
TabWidth: 4
UseTab: Never

#Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: false 
  AfterEnum: false
  AfterFunction: false           
  AfterNamespace: false
  AfterStruct: false
  BeforeElse: false
  BeforeCatch: false

# pointers and references (int* x místo int *x)
PointerAlignment: Right

# Mezery před závorkami u if/for/while
SpaceBeforeParens: ControlStatements
